# Telegram bot tokeni (@BotFather)
BOT_TOKEN=
# Admin sahifasi va /admin/reindex uchun maxfiy kalit
ADMIN_TOKEN=change-me
POSTGRES_PASSWORD=faq
# CPU oqimlari soni
TORCH_THREADS=4
# Reranker: 1 yoqilgan, 0 o'chiq (o'chiq bo'lsa tezroq, lekin aniqlik pastroq)
RERANK=1
RERANK_TOP=3
# Kulrang zona: 1-bosqich ishonchli bo'lsa reranker chaqirilmaydi
GRAY_T=0.8
GRAY_M=0.1
# Qaror chegaralari (reranker bali; eval/thresholds.json, dev to'plamida tanlangan)
R_ANSWER=0.25
R_SUGGEST=0.002
# 1-bosqich chegaralari (reranker o'chiq yoki band bo'lganda)
T_ANSWER=0.81
T_SUGGEST=0.65
# Yuklama: savollarni paketlab kodlash va reranker navbati chegarasi
BATCHING=1
RERANK_QUEUE=2
# Modellar papkasi (internetsiz muhit uchun)
HF_CACHE=
# Ovozli savolni tanish (eval/stt_bench.py da solishtirilgan). Bo'sh qoldirilsa ovozli savol o'chadi.
#   gigaam-multilingual-ctc  tavsiya: aniq va tez, 0,9 GB fayl (STT_QUANT=int8 bilan 0,2 GB)
#   nemo-conformer-ctc:OpenVoiceOS/stt_uz_fastconformer_hybrid_large_pc_onnx  NVIDIA, eng tezi
#   vosk  eski variant, VOSK_DIR dagi Kaldi modeli bilan
STT_MODEL=gigaam-multilingual-ctc
STT_QUANT=
VOSK_DIR=
